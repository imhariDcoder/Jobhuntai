%-------------------------
% Modern ATS-Friendly Resume in LaTeX
% Compiler: tectonic
%-------------------------

\documentclass[letterpaper,10.5pt]{article}

\usepackage[T1]{fontenc}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage[usenames,dvipsnames]{color}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}
\usepackage{geometry}
\usepackage{xcolor}
\usepackage{fontawesome5}

\geometry{top=0.45in, bottom=0.45in, left=0.55in, right=0.55in}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\urlstyle{same}
% flushbottom (not raggedbottom) so LaTeX distributes any leftover
% vertical space evenly across the page instead of dumping it all as
% blank space at the bottom -- matters most for shorter resumes/tailored
% subsets with fewer bullets than the full profile.
\flushbottom
\raggedright
\setlength{\tabcolsep}{0in}

%-------------------------
% Brand Color
%-------------------------
\definecolor{accent}{RGB}{26, 82, 118}
\definecolor{subtext}{RGB}{80, 80, 80}
\definecolor{rulecolor}{RGB}{180, 200, 215}
\definecolor{fillflag}{RGB}{178, 34, 34}

%-------------------------
% Section Formatting
%-------------------------
\titleformat{\section}{
  \vspace{-6pt}\color{accent}\scshape\raggedright\normalsize\bfseries
}{}{0em}{}[{\color{rulecolor}\titlerule[0.6pt]} \vspace{-4pt}]

%-------------------------
% Custom Commands
%-------------------------
\newcommand{\resumeItem}[1]{
  \item\small{#1}
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-1pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{\small#1} & \small\textcolor{subtext}{#2} \\
      \textcolor{accent}{\small\textit{#3}} & \textcolor{subtext}{\footnotesize#4} \\
    \end{tabular*}\vspace{-6pt}
}

\newcommand{\resumeProjectHeading}[2]{
  \item
  \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
    \small#1 & \textcolor{subtext}{\small #2} \\
  \end{tabular*}\vspace{-6pt}
}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}
\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=0.2in, itemsep=2pt, parsep=0pt, topsep=2pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-4pt}}
\newcommand{\resumeCertListEnd}{\end{itemize}\vspace{-10pt}}

%============================================================
%                   DOCUMENT STARTS HERE
%============================================================
\begin{document}

%-------------------------
% HEADER
%-------------------------
\begin{center}
    {\Huge \textbf{\textcolor{accent}{(( name ))}}} \\ \vspace{4pt}
    ((* if location *))
    {\small \textcolor{subtext}{(( location ))}} \\ \vspace{6pt}
    ((* endif *))
    \small
    ((* if phone *))\faPhone\ (( phone ))((* endif *))
    ((* if email *)) \quad \faEnvelope\ \href{mailto:(( email_href ))}{(( email ))}((* endif *))
    ((* if linkedin *)) \quad \faLinkedin\ \href{(( linkedin_url ))}{(( linkedin ))}((* endif *))
    ((* if github *)) \quad \faGithub\ \href{(( github_url ))}{(( github ))}((* endif *))
\end{center}

\vspace{-6pt}
\noindent\textcolor{rulecolor}{\rule{\textwidth}{1pt}}
\vspace{-4pt}

% \vfill between sections (not after the last one) so leftover vertical
% space on a shorter resume/tailored subset stretches evenly across the
% gaps between sections, instead of collecting as one dead zone at the
% bottom of the page. Contributes nothing when content already fills the
% page, so this is safe for full-length resumes too.
\vfill

((* if summary *))
%-------------------------
% PROFESSIONAL SUMMARY
%-------------------------
\section{Professional Summary}
\small{(( summary ))}
((* endif *))
\vfill

((* if experience *))
%-------------------------
% EXPERIENCE
%-------------------------
\section{(( experience_label ))}
  \resumeSubHeadingListStart
  ((* for exp in experience *))
    \resumeSubheading
      {(( exp.role ))}{(( exp.dates ))}
      {(( exp.org ))}{(( exp.location ))}
      ((* if exp.bullets *))
      \resumeItemListStart
        ((* for bullet in exp.bullets *))
        \resumeItem{(( bullet ))}
        ((* endfor *))
      \resumeItemListEnd
      ((* endif *))
  ((* endfor *))
  \resumeSubHeadingListEnd
((* endif *))
\vfill

((* if projects *))
%-------------------------
% PROJECTS
%-------------------------
\section{Projects}
    \resumeSubHeadingListStart
    ((* for proj in projects *))
      \resumeProjectHeading
        {((* if proj.link *))\href{(( proj.link ))}{\textbf{(( proj.title ))}}((* else *))\textbf{(( proj.title ))}((* endif *))((* if proj.tech_joined *)) $|$ \textcolor{accent}{\emph{(( proj.tech_joined ))}}((* endif *))}{(( proj.date ))}
        ((* if proj.bullets *))
        \resumeItemListStart
          ((* for bullet in proj.bullets *))
          \resumeItem{(( bullet ))}
          ((* endfor *))
        \resumeItemListEnd
        ((* endif *))
    ((* endfor *))
    \resumeSubHeadingListEnd
((* endif *))
\vfill

((* if skills *))
%-------------------------
% TECHNICAL SKILLS
%-------------------------
\section{Technical Skills}
\begin{itemize}[leftmargin=0.15in, label={}]
  \small\item{
    (( skills_block ))
  }
\end{itemize}
\vspace{-14pt}
((* endif *))
\vfill

((* if certifications *))
%-------------------------
% CERTIFICATIONS
%-------------------------
\section{Certifications}
  \resumeSubHeadingListStart
    ((* for cert in certifications *))
    \resumeProjectHeading
      {\textbf{(( cert.title ))} $|$ \textcolor{subtext}{\emph{(( cert.org ))}}}{(( cert.date ))}
    ((* endfor *))
  \resumeSubHeadingListEnd
((* endif *))
\vfill

((* if education *))
%-------------------------
% EDUCATION
%-------------------------
\section{Education}
  \resumeSubHeadingListStart
  ((* for edu in education *))
    \resumeSubheading
      {(( edu.degree ))}{(( edu.dates ))}
      {(( edu.org ))}{(( edu.location ))}
      ((* if edu.details *))
      \resumeItemListStart
        ((* for detail in edu.details *))
        \resumeItem{(( detail ))}
        ((* endfor *))
      \resumeItemListEnd
      ((* endif *))
  ((* endfor *))
  \resumeSubHeadingListEnd
((* endif *))

%============================================================
\end{document}
